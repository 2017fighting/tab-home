{
  "name": "tab-home",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "tab-home — your personal new tab page.",
  "scripts": {
    "predev": "mkdir -p extension/icons && cp -r src/assets/icons/. extension/icons/",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && cp -r src/assets/icons/. extension/icons/",
    "watch": "vite build --watch",
    "clean": "rm -rf extension",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/chrome": "^0.0.302",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.3.1",
    "vite-plugin-web-extension": "^4.4.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.8"
  }
}
